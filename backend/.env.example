# Backend env example
# Copy to `backend/.env` for local dev OR set env vars in your deployment.

# Required for JWT security
SECRET_KEY=change-me-in-production

# Postgres database URL (Supabase direct connection)
# Example: postgresql+asyncpg://postgres:password@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# TLS settings for DB connections
# If your network inserts a custom/corporate certificate chain, point to your CA PEM file.
DB_SSL_CA_FILE=
# Development-only escape hatch (disables TLS verification). Keep false in production.
DB_SSL_INSECURE=false

# Auth cookie settings (HttpOnly cookie auth)
COOKIE_NAME=kc_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Clone database for safe testing. It is used ONLY when you start the process
# with USE_CLONE_DB=1 in the terminal (a USE_CLONE_DB line in this file is ignored).
# Without it the app always uses DATABASE_URL (production).
#   PowerShell:  $env:USE_CLONE_DB = "1"      ...back to production:  Remove-Item Env:USE_CLONE_DB
#   bash:        export USE_CLONE_DB=1        ...back to production:  unset USE_CLONE_DB
DATABASE_URL_CLONE=

# Vector store is pgvector inside Postgres (see document_chunks table).
# UPLOAD_DIR still holds raw uploaded files on disk (ephemeral on free hosts;
# pair with STORAGE_BACKEND=supabase for persistence).
UPLOAD_DIR=../data/uploads

# Embedding model + dimension of the pgvector column.
# If EMBEDDING_DIM is unset it defaults to 768 when GEMINI_API_KEY is set,
# otherwise 384 (all-MiniLM-L6-v2 / hash fallback).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM provider selection
# - extractive: returns top passages (fast, no API calls)
# - groq: uses Groq for answer synthesis, then falls back
# - gemini: uses Gemini for answer synthesis, with extractive fallback
LLM_PROVIDER=extractive

# Optional: Groq (if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Gemini (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Storage backend for uploaded documents
# - local: save files only on local disk
# - supabase: keep local copy for indexing and upload to Supabase bucket
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=kepler-documents
SUPABASE_STUDENTS_TABLE=students

